@page
@model SmartAccounting.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="display-4">An error occurred.</h1>

<div class="alert alert-danger">
    <p>We're sorry, but something went wrong.</p>
    @if (Model?.Error != null && Model.Error.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> @Model.Error.RequestId
        </p>
    }
    <p>
        <a asp-page="/Index">Return to home</a>
    </p>
</div>
